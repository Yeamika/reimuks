#!/bin/busybox sh
export PATH=/bin:/sbin
export HOME=/
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /run
rescue() {
    echo "REIMUKS boot stopped: $*"
    echo 'Type exit to reboot.'
    setsid cttyhack sh
    reboot -f
    while :; do sleep 3600; done
}
# EFI writes a canonical UUID plus one NUL to the DT property.
root=
chosen=/sys/firmware/devicetree/base/chosen/w202,root-partuuid
if [ -r "$chosen" ]; then
    [ "$(wc -c < "$chosen")" -eq 37 ] || rescue 'invalid DT root PARTUUID size'
    [ "$(tail -c 1 "$chosen" | od -An -tu1 | tr -d ' \n')" = 0 ] || rescue 'unterminated DT root PARTUUID'
    value=$(tr -d '\000' < "$chosen")
    [ "${#value}" -eq 36 ] || rescue 'invalid DT root PARTUUID length'
    hex=$(printf %s "$value" | tr -d '-')
    [ "${#hex}" -eq 32 ] || rescue 'invalid DT root PARTUUID hyphens'
    case "$value" in *[!0-9a-fA-F-]*) rescue 'invalid DT root PARTUUID characters' ;; esac
    case "$value" in
        ????????-????-????-????-????????????) root="PARTUUID=$value" ;;
        *) rescue 'invalid DT root PARTUUID' ;;
    esac
fi
# DT selection takes precedence; command-line is fallback (may be forced by kernel).
if [ -z "$root" ]; then
    for arg in $(cat /proc/cmdline); do
        case "$arg" in root=*) root=${arg#root=} ;; esac
    done
fi
[ -n "$root" ] || rescue 'supply DT w202,root-partuuid or kernel root=PARTUUID=...'
for module in $(cat /etc/early-modules); do
    modprobe "$module" || rescue "module failed: $module"
done
n=0
device=
while [ "$n" -lt 60 ]; do
    mdev -s
    case "$root" in
        PARTUUID=*|UUID=*|LABEL=*) device=$(blkid -l -t "$root" -o device 2>/dev/null) ;;
        /dev/*) device=$root ;;
        *) rescue 'unsupported root selector' ;;
    esac
    [ -n "$device" ] && [ -b "$device" ] && break
    n=$((n+1))
    sleep 1
done
[ -n "$device" ] && [ -b "$device" ] || rescue "root not found: $root"
mount -t ext4 -o ro "$device" /newroot || rescue 'ext4 mount failed'
release=$(uname -r)
[ -f "/newroot/usr/lib/reimuks/kernel-release" ] || rescue 'rootfs has no kernel identity'
[ "$(cat /newroot/usr/lib/reimuks/kernel-release)" = "$release" ] || rescue 'rootfs kernel release mismatch'
[ "$(cat /newroot/usr/lib/reimuks/kernel-image.sha256)" = "$(cat /etc/kernel-image.sha256)" ] || rescue 'rootfs kernel build mismatch'
[ -d "/newroot/usr/lib/modules/$release" ] || rescue 'rootfs modules missing'
[ -x /newroot/sbin/init ] || rescue 'rootfs init missing'
mount -o remount,rw /newroot || rescue 'rootfs remount failed'
mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /run /newroot/run
exec switch_root /newroot /sbin/init || rescue 'switch_root failed'
