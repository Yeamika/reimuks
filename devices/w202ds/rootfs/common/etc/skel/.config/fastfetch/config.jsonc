{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    {
      "type": "command",
      "key": "Hostname",
      "text": "hostname"
    },
    {
      "type": "host",
      "key": "Device",
      "format": "W202DS"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    {
      "type": "cpu",
      "format": "UNISOC UMS9620 ({cores-online} cores) @ {freq-max}"
    },
    {
      "type": "gpu",
      "format": "ARM Mali-G57 · {driver}"
    },
    {
      "type": "command",
      "key": "VPU",
      "text": "if [ -r /sys/class/misc/sprd_vsp/device/utilization ]; then awk '{for(i=1;i<=NF;i++) if($i ~ /^frequency_hz=/) {split($i,a,\"=\"); printf \"UNISOC VSP · %.0f MHz\\n\", a[2]/1000000}}' /sys/class/misc/sprd_vsp/device/utilization; else printf 'UNISOC VSP · statistics unavailable\\n'; fi"
    },
    "memory",
    "swap",
    "disk",
    "battery",
    "localip",
    "break",
    "colors"
  ]
}
