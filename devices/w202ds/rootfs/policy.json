{
  "schema": 1,
  "common": {
    "components": [
      "usb3",
      "drm",
      "charging",
      "audio",
      "gpu",
      "vpu",
      "touchscreen",
      "wcn",
      "modem",
      "sensorhub",
      "keyboard"
    ],
    "overlays": [
      "common"
    ],
    "services": {
      "multi-user.target.wants/w202-usb-gadget.service": "w202-usb-gadget.service",
      "getty.target.wants/serial-getty@ttyGS0.service": "serial-getty@.service",
      "multi-user.target.wants/w202-charging.service": "w202-charging.service",
      "multi-user.target.wants/w202-audio.service": "w202-audio.service",
      "multi-user.target.wants/w202-touch.service": "w202-touch.service",
      "multi-user.target.wants/w202-wifi.service": "w202-wifi.service",
      "multi-user.target.wants/w202-bluetooth.service": "w202-bluetooth.service",
      "multi-user.target.wants/w202-modem-runtime.service": "w202-modem-runtime.service",
      "multi-user.target.wants/w202-sensorhub.service": "w202-sensorhub.service",
      "multi-user.target.wants/w202-keyboard.service": "w202-keyboard.service"
    },
    "remove": [
      "etc/systemd/system/ssh.service.d/20-w202-ready.conf",
      "etc/systemd/system/multi-user.target.wants/w202-hall.service",
      "etc/systemd/system/w202-hall.service.d/50-kernel-compat.conf",
      "usr/lib/systemd/system/w202-hall.service",
      "usr/libexec/w202-vpu",
      "usr/bin/w202-vpu",
      "usr/libexec/w202-vpu-start",
      "usr/libexec/w202-vpu-stop",
      "usr/libexec/w202-vpu-worker-ns",
      "usr/lib/systemd/system/w202-vpu.service",
      "etc/systemd/system/multi-user.target.wants/w202-vpu.service"
    ],
    "verify": {
      "files": [
        "usr/libexec/w202-usb-gadget",
        "usr/lib/systemd/system/w202-usb-gadget.service",
        "etc/default/w202-usb-gadget",
        "etc/systemd/network/80-w202-usb.network",
        "etc/systemd/system/serial-getty@ttyGS0.service.d/w202-usb-gadget.conf",
        "etc/modprobe.d/w202-modem-ordered.conf"
      ],
      "executables": [
        "usr/libexec/w202-usb-gadget"
      ],
      "symlinks": [
        "etc/systemd/system/multi-user.target.wants/w202-usb-gadget.service",
        "etc/systemd/system/getty.target.wants/serial-getty@ttyGS0.service",
        "etc/systemd/system/w202-vpu.service"
      ],
      "contains": {
        "etc/systemd/system/serial-getty@ttyGS0.service.d/w202-usb-gadget.conf": [
          "w202-usb-gadget.service"
        ],
        "etc/systemd/network/80-w202-usb.network": [
          "192.168.77.2/24"
        ],
        "etc/default/w202-usb-gadget": [
          "USB_ADDRESS=192.168.77.2/24"
        ],
        "etc/modprobe.d/w202-modem-ordered.conf": [
          "blacklist trusty_virtio",
          "blacklist trusty_ipc"
        ]
      },
      "absent": [
        "usr/libexec/w202-vpu",
        "usr/bin/w202-vpu",
        "usr/libexec/w202-vpu-start",
        "usr/libexec/w202-vpu-stop",
        "usr/libexec/w202-vpu-worker-ns",
        "usr/lib/systemd/system/w202-vpu.service",
        "etc/systemd/system/multi-user.target.wants/w202-vpu.service"
      ],
      "absent_prefixes": [
        "opt/w202ds/vpu/android"
      ],
      "link_targets": {
        "etc/systemd/system/w202-vpu.service": "/dev/null"
      }
    }
  },
  "profiles": {
    "desktop/server": {
      "overlays": [
        "profiles/desktop/server"
      ],
      "services": {
        "multi-user.target.wants/w202-display-login.service": "w202-display-login.service",
        "multi-user.target.wants/systemd-networkd.service": "systemd-networkd.service"
      },
      "verify": {
        "symlinks": [
          "etc/systemd/system/multi-user.target.wants/systemd-networkd.service"
        ]
      }
    },
    "desktop/kde": {
      "overlays": [
        "profiles/desktop/kde"
      ],
      "disable": [
        "multi-user.target.wants/systemd-networkd.service"
      ],
      "desktop_common": true,
      "control_artifacts": [
        {
          "rootfs": "device-controls/kde-rootfs",
          "executables": [
            "w202-hardware-controls",
            "w202-tablet-mode",
            "w202-lid-wake",
            "w202-tablet-notify",
            "w202-gnss-toggle"
          ]
        }
      ],
      "verify": {
        "absent": [
          "etc/systemd/system/multi-user.target.wants/systemd-networkd.service"
        ],
        "contains": {
          "home/reimuks/.local/share/plasma/layout-templates/org.kde.plasma.desktop.defaultPanel/contents/layout.js": [
            "panel.location = \"left\""
          ]
        }
      },
      "rootfs_artifacts": [
        {
          "rootfs": "desktop-kde/rootfs",
          "required_elf": [
            "usr/bin/w202-rotation",
            "usr/lib/aarch64-linux-gnu/qt6/plugins/ksystemstats/ksystemstats_plugin_w202_vpu.so"
          ]
        }
      ],
      "preparers": [
        "desktop/kde/prepare.py"
      ]
    },
    "desktop/gnome": {
      "overlays": [
        "profiles/desktop/gnome"
      ],
      "disable": [
        "multi-user.target.wants/systemd-networkd.service"
      ],
      "desktop_common": true,
      "verify": {
        "absent": [
          "etc/systemd/system/multi-user.target.wants/systemd-networkd.service"
        ]
      }
    }
  },
  "desktop_common": {
    "overlays": [
      "desktop-common"
    ],
    "services": {
      "bluetooth.service.wants/w202-bluetooth-state.service": "w202-bluetooth-state.service",
      "multi-user.target.wants/w202-hall-input.service": "w202-hall-input.service",
      "multi-user.target.wants/ModemManager.service": "ModemManager.service"
    },
    "components": [
      "hall",
      "camera",
      "vpu-vaapi"
    ],
    "control_artifacts": [
      {
        "rootfs": "device-controls/rootfs",
        "executables": [
          "w202-usb-settings",
          "w202-device-controls",
          "w202-gnss-control",
          "w202-bluetooth-state",
          "w202-tablet-resync",
          "w202-hotspot-switch",
          "w202-hotspot-scan"
        ]
      }
    ],
    "verify": {
      "files": [
        "etc/reimuks/acceleration.json",
        "etc/environment.d/60-w202-video.conf",
        "usr/lib/aarch64-linux-gnu/dri/v4l2_request_drv_video.so"
      ],
      "contains": {
        "etc/environment.d/60-w202-video.conf": [
          "LIBVA_DRIVER_NAME=v4l2_request"
        ]
      }
    }
  }
}
