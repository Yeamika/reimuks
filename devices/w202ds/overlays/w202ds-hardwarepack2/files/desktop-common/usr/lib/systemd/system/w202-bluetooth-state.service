[Unit]
Description=Remember the last Bluetooth power state
Requires=bluetooth.service
After=bluetooth.service w202-bluetooth.service
PartOf=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/libexec/w202-bluetooth-state
Restart=on-failure
RestartSec=2
StateDirectory=reimuks
UMask=0077

[Install]
WantedBy=bluetooth.service
