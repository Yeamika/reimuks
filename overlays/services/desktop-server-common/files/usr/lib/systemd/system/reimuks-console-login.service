[Unit]
Description=Present the system console after startup
DefaultDependencies=no
After=basic.target multi-user.target
Conflicts=shutdown.target
Before=shutdown.target
[Service]
Type=oneshot
ExecStart=/usr/libexec/reimuks-console-login
RemainAfterExit=yes
TimeoutStartSec=20
[Install]
WantedBy=multi-user.target
